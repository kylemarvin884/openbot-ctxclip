  },
  "scripts": {
    "start": "node demo/demo.mjs",
    "demo": "node demo/demo.mjs",
    "test": "node --test"
  },
  "keywords": [
    "ai",
    "agent",
    "cli",
    "context-engineering",
    "context-window",
    "log-compression",
    "developer-tools",
    "testing"
  ],
